# Copy to .env and fill in. Never commit the real .env.

# --- Meraki exporter ---
MERAKI_API_KEY=
MERAKI_ORG_IDS=793196484370628661,793196484370628847,968673,1146023
EXPORTER_PORT=9822
POLL_INTERVAL_SECONDS=60
MERAKI_ORG_RATE_LIMIT=5
COLLECT_DEVICE_HEALTH=true
COLLECT_SWITCH_PORTS=true
COLLECT_WIRELESS=true
COLLECT_INVENTORY=true
SITES_FILE=/config/sites.json
CAPACITY_FILE=/config/capacity.yml
INVENTORY_SNAPSHOT_DIR=/var/lib/network-telemetry/inventory
LOG_LEVEL=INFO

# --- vManage exporter ---
VMANAGE_HOST=
VMANAGE_PORT=443
VMANAGE_USER=
VMANAGE_PASS=
VMANAGE_VERIFY_TLS=false
VMANAGE_CA_BUNDLE=
# EXPORTER_PORT=9823 is set in compose for this service

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
GF_USERS_ALLOW_SIGN_UP=false
