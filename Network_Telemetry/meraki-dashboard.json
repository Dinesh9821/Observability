        "label": "Site ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (site_id) (last_over_time(meraki_device_up{region=~\"$region\",country=~\"$country\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (site_id) (last_over_time(meraki_device_up{region=~\"$region\",country=~\"$country\"}[24h])))",
