        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (device_name) (last_over_time(meraki_device_up{region=~\"$region\",country=~\"$country\",site_id=~\"$site_id\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (device_name) (last_over_time(meraki_device_up{region=~\"$region\",country=~\"$country\",site_id=~\"$site_id\"}[24h])))",
