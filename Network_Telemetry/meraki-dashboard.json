  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (region) (last_over_time(meraki_device_up[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (region) (last_over_time(meraki_device_up[24h])))",
          "refId": "var-region"
        },
        "regex": "/region=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "country",
        "label": "Country",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (country) (last_over_time(meraki_device_up{region=~\"$region\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (country) (last_over_time(meraki_device_up{region=~\"$region\"}[24h])))",
          "refId": "var-country"
        },
        "regex": "/country=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
