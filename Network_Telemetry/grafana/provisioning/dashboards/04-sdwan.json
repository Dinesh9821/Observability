        "definition": "query_result(count by (hostname) (last_over_time(vmanage_device_reachable{region=~\"$region\",country=~\"$country\",site_id=~\"$site_id\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (hostname) (last_over_time(vmanage_device_reachable{region=~\"$region\",country=~\"$country\",site_id=~\"$site_id\"}[24h])))",
