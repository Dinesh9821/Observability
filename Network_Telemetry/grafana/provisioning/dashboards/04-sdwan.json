          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (site_id) (last_over_time(vmanage_device_reachable{region=~\"$region\",country=~\"$country\"}[24h])))",
        "query": {
          "qryType": 3,
