{
  "uid": "complete-observability",
  "title": "Complete Observability Dashboard",
  "description": "Region > Country > Site > Device. Shows estate-wide rollups until a device is selected. site_id is the first two tokens of the hostname (AT-5789-ASD01 -> AT-5789); region and country come from the site register.",
  "tags": [
    "observability",
    "meraki",
    "wan"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(meraki_site_devices_total, region)",
        "query": {
          "qryType": 1,
          "query": "label_values(meraki_site_devices_total, region)",
          "refId": "var-region"
        },
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "country",
        "label": "Country",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(meraki_site_devices_total{region=~\"$region\"}, country)",
        "query": {
          "qryType": 1,
          "query": "label_values(meraki_site_devices_total{region=~\"$region\"}, country)",
          "refId": "var-country"
        },
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "site",
        "label": "Site ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(meraki_site_devices_total{region=~\"$region\", country=~\"$country\"}, site_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(meraki_site_devices_total{region=~\"$region\", country=~\"$country\"}, site_id)",
          "refId": "var-site"
        },
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(meraki_device_up{region=~\"$region\", country=~\"$country\", site_id=~\"$site\"}, device_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(meraki_device_up{region=~\"$region\", country=~\"$country\", site_id=~\"$site\"}, device_name)",
          "refId": "var-device"
        },
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Estate overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Site Health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Percentage of devices online across the selected scope.",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "#EAB839",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "avg(meraki_site_health_percent{region=~\"$region\", country=~\"$country\", site_id=~\"$site\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "health"
        }
      ]
    },
