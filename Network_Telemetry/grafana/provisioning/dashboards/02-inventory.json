        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (device) (last_over_time(device_info{region=~\"$region\",country=~\"$country\",site_id=~\"$site_id\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (device) (last_over_time(device_info{region=~\"$region\",country=~\"$country\",site_id=~\"$site_id\"}[24h])))",
