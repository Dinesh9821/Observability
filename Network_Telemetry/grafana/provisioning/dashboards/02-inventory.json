          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (site_id) (last_over_time(device_info{region=~\"$region\",country=~\"$country\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (site_id) (last_over_time(device_info{region=~\"$region\",country=~\"$country\"}[24h])))",
          "refId": "var-site_id"
