# Host (systemd) environment. Copy to /etc/network-telemetry/exporters.env
# chmod 600. Never commit the filled file.

MERAKI_API_KEY=
MERAKI_ORG_IDS=793196484370628661,793196484370628847,968673,1146023
POLL_INTERVAL_SECONDS=60
MERAKI_ORG_RATE_LIMIT=5
COLLECT_DEVICE_HEALTH=true
COLLECT_SWITCH_PORTS=true
COLLECT_WIRELESS=true
COLLECT_INVENTORY=true
SITES_FILE=/etc/network-telemetry/sites.json
CAPACITY_FILE=/etc/network-telemetry/capacity.yml
INVENTORY_SNAPSHOT_DIR=/var/lib/network-telemetry/inventory
LOG_LEVEL=INFO

VMANAGE_HOST=
VMANAGE_PORT=443
VMANAGE_USER=
VMANAGE_PASS=
VMANAGE_VERIFY_TLS=false
VMANAGE_CA_BUNDLE=

# Do not set EXPORTER_PORT here. Each systemd unit sets its own port.
